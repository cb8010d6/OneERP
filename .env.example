# ============================================================
#  Enterprise ERP (.env.example)
#  复制本文件为 .env 并填写实际值:  cp .env.example .env
# ============================================================

# ---- 数据库 (PostgreSQL) ----
# Prisma 和 Kysely 均使用此连接串
DATABASE_URL=postgresql://eip_user:eip_password@localhost:5432/eip_db

# ---- JWT 认证 ----
# 用于签发和校验 Bearer Token，请使用足够随机的强密钥
JWT_SECRET=EIP_SECRET_KEY_SUPER_SECURE

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password

# ---- API 服务 ----
PORT=8000

# ---- OpenAI (可选) ----
# 配置后可启用 AI Command Bar / Chat2SQL / Chat2Dash 等 AI 功能
# 未配置时 AI 功能自动降级为规则引擎
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
