  bankAccount       String?
  transactionDate   DateTime
  description       String?
  counterparty      String?
  amount            Decimal                 @db.Decimal(18, 4)
  externalRef       String?
  status            BankStatementLineStatus @default(UNMATCHED)
  paymentId         String?
  supplierPaymentId String?
  matchedAt         DateTime?
  matchedBy         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment         Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  supplierPayment SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)

  @@unique([companyId, externalRef])
  @@index([companyId, status, transactionDate])
  @@index([paymentId])
  @@index([supplierPaymentId])
}

model Account {
  id        String   @id @default(uuid())
  code      String
  name      String
  type      String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  parentId  String?
  companyId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent                 Account?                @relation("AccountTree", fields: [parentId], references: [id])
  children               Account[]               @relation("AccountTree")
  company                Company                 @relation(fields: [companyId], references: [id])
  lines                  JournalEntryLine[]
  taxCodes               TaxCode[]
  financeAccountMappings FinanceAccountMapping[]

  @@unique([companyId, code])
  @@index([companyId, parentId])
}

model FinanceAccountMapping {
  id        String   @id @default(uuid())
  key       String
  label     String
  accountId String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([companyId, key])
  @@index([companyId])
  @@index([accountId])
}

model Journal {
  id        String      @id @default(uuid())
  code      String
  name      String
  type      JournalType @default(GENERAL)
  companyId String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company        @relation(fields: [companyId], references: [id])
  entries JournalEntry[]

  @@unique([companyId, code])
  @@index([companyId, type])
}

model JournalEntry {
  id            String             @id @default(uuid())
  entryNo       String
  date          DateTime
  ref           String?
  description   String?
  journalId     String
  companyId     String
  postingStatus EntryPostingStatus @default(DRAFT)
  createdBy     String?
  postedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  journal Journal            @relation(fields: [journalId], references: [id])
  company Company            @relation(fields: [companyId], references: [id])
  lines   JournalEntryLine[]

  @@unique([companyId, entryNo])
  @@index([companyId, journalId, date])
}

model JournalEntryLine {
  id             String   @id @default(uuid())
  journalEntryId String
  lineNo         Int
  accountId      String
  partnerId      String?
  debit          Decimal  @default(0) @db.Decimal(18, 4)
  credit         Decimal  @default(0) @db.Decimal(18, 4)
  memo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
  partner      Partner?     @relation(fields: [partnerId], references: [id])

  @@unique([journalEntryId, lineNo])
  @@index([accountId])
  @@index([partnerId])
}

model AccountingPeriod {
  id        String                 @id @default(uuid())
  companyId String
  periodKey String
  startDate DateTime
  endDate   DateTime
  status    AccountingPeriodStatus @default(OPEN)
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodKey])
  @@index([companyId, status, startDate, endDate])
}

model EventDlq {
  id             String    @id @default(uuid())
  eventName      String
  idempotencyKey String?
  payload        Json
  error          String
  attempts       Int       @default(1)
  maxAttempts    Int       @default(5)
  nextRetryAt    DateTime?
  status         String    @default("PENDING")
  companyId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  @@index([status, nextRetryAt])
  @@index([eventName])
  @@index([eventName, idempotencyKey])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   Json?
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, entity, createdAt])
  @@index([userId, createdAt])
}
