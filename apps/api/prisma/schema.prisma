model FileRecord {
  id             String   @id @default(uuid())
  fileName       String
  fileSize       Int
  mimeType       String
  objectKey      String // MinIO object name
  companyId      String
  uploaderId     String
  checksumSha256 String?
  createdAt      DateTime @default(now())

  company                     Company                      @relation(fields: [companyId], references: [id])
  uploader                    User                         @relation(fields: [uploaderId], references: [id])
  signedContract              SalesContract?
  engineeringDocumentRevision EngineeringDocumentRevision?
}

model EngineeringDocument {
  id                        String   @id @default(uuid())
  documentNo                String
  title                     String
  documentType              String
  externalNo                String?
  productId                 String?
  orderId                   String?
  currentRevisionNo         Int      @default(1)
  currentReleasedRevisionId String?  @unique
  companyId                 String
  createdById               String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company                 Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator                 User                          @relation("EngineeringDocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  product                 Product?                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  order                   Order?                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  revisions               EngineeringDocumentRevision[] @relation("EngineeringDocumentRevisions")
  currentReleasedRevision EngineeringDocumentRevision?  @relation("CurrentReleasedEngineeringRevision", fields: [currentReleasedRevisionId], references: [id], onDelete: Restrict)
  engineeringChangeOrders EngineeringChangeOrder[]

  @@unique([companyId, documentNo])
  @@index([companyId, updatedAt])
  @@index([companyId, productId])
  @@index([companyId, orderId])
}

model EngineeringDocumentRevision {
  id                    String    @id @default(uuid())
  engineeringDocumentId String
  companyId             String
  revisionNo            Int
  status                String    @default("DRAFT")
  fileRecordId          String    @unique
  checksumSha256        String
  notes                 String?
  createdById           String
  submittedAt           DateTime?
  reviewedById          String?
  reviewedAt            DateTime?
  reviewComment         String?
  approvedById          String?
  approvedAt            DateTime?
  releasedAt            DateTime?
  obsoleteAt            DateTime?
  createdAt             DateTime  @default(now())

  engineeringDocument EngineeringDocument            @relation("EngineeringDocumentRevisions", fields: [engineeringDocumentId], references: [id], onDelete: Restrict)
  company             Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fileRecord          FileRecord                     @relation(fields: [fileRecordId], references: [id], onDelete: Restrict)
  creator             User                           @relation("EngineeringRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewer            User?                          @relation("EngineeringRevisionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  approver            User?                          @relation("EngineeringRevisionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  releasedForDocument EngineeringDocument?           @relation("CurrentReleasedEngineeringRevision")
  workOrderPins       WorkOrderEngineeringRevision[]
  sourceChangeOrders  EngineeringChangeOrder[]       @relation("EngineeringChangeOrderSourceRevision")
  targetChangeOrders  EngineeringChangeOrder[]       @relation("EngineeringChangeOrderTargetRevision")

  @@unique([engineeringDocumentId, revisionNo])
  @@index([companyId, createdAt])
  @@index([engineeringDocumentId, status])
}

model InventoryTransaction {
  id               String   @id @default(uuid())
  type             String // "INBOUND", "OUTBOUND", "TRANSFER"
  materialId       String
  sourceLocationId String?
  destLocationId   String?
  quantity         Decimal  @db.Decimal(18, 4)
  batchNo          String?
  operatorId       String
  companyId        String
  referenceNo      String? // 关联单号（订单号/采购号等）
  note             String?
  createdAt        DateTime @default(now())

  material       Material       @relation(fields: [materialId], references: [id])
  company        Company        @relation(fields: [companyId], references: [id])
  sourceLocation StockLocation? @relation("StockMoveSourceLocation", fields: [sourceLocationId], references: [id])
  destLocation   StockLocation? @relation("StockMoveDestinationLocation", fields: [destLocationId], references: [id])

  @@index([companyId, materialId])
  @@index([sourceLocationId])
  @@index([destLocationId])
  @@index([companyId, createdAt])
  @@index([companyId, type, createdAt])
}

model InventoryReturnDocument {
  id               String   @id @default(uuid())
  returnNo         String   @unique
  returnType       String // "SALES", "PURCHASE"
  sourceDocumentId String?
  sourceDocumentNo String
  referenceNo      String
  status           String   @default("POSTED")
  note             String?
  operatorId       String?
  postedAt         DateTime @default(now())
  companyId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines              InventoryReturnLine[]
  creditNote         CreditNote?
  supplierCreditNote SupplierCreditNote?

  @@unique([companyId, referenceNo])
  @@index([companyId, returnType, postedAt])
  @@index([sourceDocumentNo])
}

model InventoryReturnLine {
  id               String   @id @default(uuid())
  returnDocumentId String
  materialId       String
  quantity         Decimal  @db.Decimal(18, 4)
  locationId       String?
  inventoryMoveId  String?
  batchNo          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  returnDocument InventoryReturnDocument @relation(fields: [returnDocumentId], references: [id], onDelete: Cascade)

  @@index([returnDocumentId])
  @@index([materialId])
  @@index([inventoryMoveId])
}

model Workflow {
  id          String   @id @default(uuid())
  modelName   String
  companyId   String?
  name        String
  statusField String   @default("status")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?             @relation(fields: [companyId], references: [id])
  states      WorkflowState[]
  transitions WorkflowTransition[]

  @@unique([companyId, modelName])
  @@index([modelName])
}

model WorkflowState {
  id         String   @id @default(uuid())
  workflowId String
  value      String
  label      String
  isInitial  Boolean  @default(false)
  isFinal    Boolean  @default(false)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workflow Workflow             @relation(fields: [workflowId], references: [id])
  from     WorkflowTransition[] @relation("WorkflowTransitionFrom")
  to       WorkflowTransition[] @relation("WorkflowTransitionTo")

  @@unique([workflowId, value])
  @@index([workflowId, sort])
}

model WorkflowTransition {
  id          String   @id @default(uuid())
  workflowId  String
  fromStateId String
  toStateId   String
  action      String
  label       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflow  Workflow      @relation(fields: [workflowId], references: [id])
  fromState WorkflowState @relation("WorkflowTransitionFrom", fields: [fromStateId], references: [id])
  toState   WorkflowState @relation("WorkflowTransitionTo", fields: [toStateId], references: [id])

  @@unique([workflowId, fromStateId, action])
  @@index([workflowId, action])
}

model WorkOrder {
  id          String   @id @default(uuid())
  workOrderNo String   @unique
  orderId     String
  productId   String
  plannedQty  Int
  actualQty   Int      @default(0)
  status      String // "PENDING", "IN_PROGRESS", "COMPLETED"
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order                    Order                          @relation(fields: [orderId], references: [id])
  product                  Product                        @relation(fields: [productId], references: [id])
  reports                  WorkReport[]
  engineeringRevisionPins  WorkOrderEngineeringRevision[]
  engineeringChangeImpacts EngineeringChangeImpact[]
}

model WorkOrderEngineeringRevision {
  id                    String   @id @default(uuid())
  workOrderId           String
  engineeringRevisionId String
  companyId             String
  pinnedById            String
  createdAt             DateTime @default(now())

  workOrder           WorkOrder                   @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  engineeringRevision EngineeringDocumentRevision @relation(fields: [engineeringRevisionId], references: [id], onDelete: Restrict)
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  pinnedBy            User                        @relation("EngineeringRevisionPinnedBy", fields: [pinnedById], references: [id], onDelete: Restrict)

  @@unique([workOrderId, engineeringRevisionId])
  @@index([companyId, createdAt])
  @@index([engineeringRevisionId])
}

model EngineeringChangeOrder {
  id                    String    @id @default(uuid())
  ecoNo                 String
  engineeringDocumentId String
  sourceRevisionId      String
  targetRevisionId      String    @unique
  companyId             String
  status                String    @default("DRAFT")
  reason                String
  impactAssessment      String
  materialDisposition   String
  createdById           String
  submittedAt           DateTime?
  approvedById          String?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  approvalComment       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  engineeringDocument EngineeringDocument         @relation(fields: [engineeringDocumentId], references: [id], onDelete: Restrict)
  sourceRevision      EngineeringDocumentRevision @relation("EngineeringChangeOrderSourceRevision", fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  targetRevision      EngineeringDocumentRevision @relation("EngineeringChangeOrderTargetRevision", fields: [targetRevisionId], references: [id], onDelete: Restrict)
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator             User                        @relation("EngineeringChangeOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approver            User?                       @relation("EngineeringChangeOrderApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  impacts             EngineeringChangeImpact[]

  @@unique([companyId, ecoNo])
  @@index([companyId, status, createdAt])
  @@index([engineeringDocumentId, createdAt])
  @@index([sourceRevisionId])
}

model EngineeringChangeImpact {
  id                       String    @id @default(uuid())
  engineeringChangeOrderId String
  workOrderId              String
  companyId                String
  decision                 String
  note                     String?
  appliedAt                DateTime?
  createdAt                DateTime  @default(now())

  engineeringChangeOrder EngineeringChangeOrder @relation(fields: [engineeringChangeOrderId], references: [id], onDelete: Restrict)
  workOrder              WorkOrder              @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  company                Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([engineeringChangeOrderId, workOrderId])
  @@index([companyId, createdAt])
  @@index([workOrderId])
}

model WorkReport {
  id                      String   @id @default(uuid())
  workOrderId             String
  workerId                String
  companyId               String
  idempotencyKey          String
  payloadHash             String
  goodQty                 Int
  defectQty               Int
  inventoryTransactionIds Json     @default("[]")
  reportDate              DateTime @default(now())

  workOrder WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  worker    User                @relation(fields: [workerId], references: [id], onDelete: Restrict)
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reversal  WorkReportReversal?

  @@unique([companyId, idempotencyKey])
  @@index([companyId, reportDate])
  @@index([workOrderId, reportDate])
}

model WorkReportReversal {
  id                      String   @id @default(uuid())
  workReportId            String   @unique
  companyId               String
  idempotencyKey          String
  payloadHash             String
  reason                  String
  reversedById            String
  inventoryTransactionIds Json     @default("[]")
  createdAt               DateTime @default(now())

  workReport WorkReport @relation(fields: [workReportId], references: [id], onDelete: Restrict)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reversedBy User       @relation("WorkReportReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
}

model Invoice {
  id            String             @id @default(uuid())
