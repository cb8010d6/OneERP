  partnerId     String
  amount        Decimal            @db.Decimal(18, 4)
  method        String // "BANK_TRANSFER", "CASH", "WECHAT", "ALIPAY"
  status        String             @default("DRAFT") // "DRAFT", "POSTED", "CANCELLED"
  postingStatus EntryPostingStatus @default(DRAFT)
  postedAt      DateTime?
  refundDate    DateTime           @default(now())
  note          String?
  companyId     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id])
  partner    Partner    @relation(fields: [partnerId], references: [id])
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, refundDate])
  @@index([creditNoteId])
  @@index([partnerId, refundDate])
  @@index([postingStatus])
}

model SupplierCreditNote {
