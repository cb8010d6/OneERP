  subTotal      Decimal            @default(0) @db.Decimal(18, 4)
  taxAmount     Decimal            @default(0) @db.Decimal(18, 4)
  taxCodeId     String?
  status        String // "UNPAID", "PARTIAL", "PAID"
  postingStatus EntryPostingStatus @default(DRAFT)
  companyId     String
  dueDate       DateTime?
  issuedDate    DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  order              Order               @relation(fields: [orderId], references: [id])
  taxCode            TaxCode?            @relation(fields: [taxCodeId], references: [id])
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  creditNotes        CreditNote[]

  @@index([companyId, status])
  @@index([companyId, dueDate])
}

model CreditNote {
  id                        String             @id @default(uuid())
  creditNo                  String             @unique
  invoiceId                 String
  partnerId                 String
  amount                    Decimal            @db.Decimal(18, 4)
  subTotal                  Decimal            @default(0) @db.Decimal(18, 4)
  taxAmount                 Decimal            @default(0) @db.Decimal(18, 4)
  receivableAppliedAmount   Decimal            @default(0) @db.Decimal(18, 4)
  refundLiabilityAmount     Decimal            @default(0) @db.Decimal(18, 4)
  taxCodeId                 String?
  inventoryReturnDocumentId String?            @unique
  reason                    String?
  status                    String             @default("DRAFT") // "DRAFT", "POSTED", "CANCELLED"
  postingStatus             EntryPostingStatus @default(DRAFT)
  postedAt                  DateTime?
  creditDate                DateTime           @default(now())
  companyId                 String
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  invoice                 Invoice                  @relation(fields: [invoiceId], references: [id])
  partner                 Partner                  @relation(fields: [partnerId], references: [id])
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxCode                 TaxCode?                 @relation(fields: [taxCodeId], references: [id])
  inventoryReturnDocument InventoryReturnDocument? @relation(fields: [inventoryReturnDocumentId], references: [id], onDelete: SetNull)
  refunds                 CustomerRefund[]

  @@index([companyId, creditDate])
  @@index([invoiceId])
  @@index([partnerId, creditDate])
  @@index([postingStatus])
  @@index([inventoryReturnDocumentId])
