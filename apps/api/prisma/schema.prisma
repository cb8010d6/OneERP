// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 核心模块: 多公司与统一认证
// ==========================================

model Company {
  id          String   @id @default(uuid())
  name        String // 公司名称
  taxId       String? // 税号
  address     String? // 公司地址
  phone       String? // 联系电话
  legalPerson String? // 法定代表人
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserCompanyRole[]
  departments Department[]
  orders      Order[]
  warehouses  Warehouse[]
  locations   StockLocation[]
  materials   Material[]
  partners    Partner[]
  products    Product[]
  categories  ProductCategory[]
  boms        Bom[]
  fileRecords FileRecord[]
  workflows   Workflow[]
  customFields CustomFieldDefinition[]
  auditLogs   AuditLog[]
  accounts    Account[]
  journals    Journal[]
  journalEntries JournalEntry[]
  eventDlqRecords EventDlq[]
  taxCodes    TaxCode[]
  userInvitations UserInvitation[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  purchaseInvoices PurchaseInvoice[]
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum ProductType {
  STOCKABLE
  CONSUMABLE
  SERVICE
}

enum CustomFieldType {
  STRING
  NUMBER
  REF
}

enum JournalType {
  GENERAL
  CASH
  BANK
  SALES
  PURCHASE
  INVENTORY
}

enum EntryPostingStatus {
  DRAFT
  POSTED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies  UserCompanyRole[]
  orders     Order[]           @relation("UserOrders")
  purchaseOrders PurchaseOrder[] @relation("UserPurchaseOrders")
  purchaseReceipts PurchaseReceipt[] @relation("UserPurchaseReceipts")
  FileRecord FileRecord[]
  WorkReport WorkReport[]
  auditLogs  AuditLog[]
  createdInvitations UserInvitation[] @relation("InvitationCreatedBy")
  acceptedInvitations UserInvitation[] @relation("InvitationAcceptedBy")
}

model Role {
  id          String   @id @default(uuid())
  name        String // "ADMIN", "SALES", "MANAGER" 等
  permissions String[] // JSON or Array 存放详细权限点，例如 ["order:read", "order:write"]

  users UserCompanyRole[]
  invitations UserInvitation[]
}

// 用户在特定公司下的角色关联表
model UserCompanyRole {
  id        String @id @default(uuid())
  userId    String
  companyId String
  roleId    String

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
}

model UserInvitation {
  id          String    @id @default(uuid())
  email       String
  name        String?
  tokenHash   String    @unique
  companyId   String
  roleId      String
  createdById String
  acceptedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company    Company @relation(fields: [companyId], references: [id])
  role       Role    @relation(fields: [roleId], references: [id])
  createdBy  User    @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([companyId, email])
  @@index([companyId, createdAt])
}

model Department {
  id        String @id @default(uuid())
  name      String
  companyId String

  company Company @relation(fields: [companyId], references: [id])
}

model Partner {
  id        String      @id @default(uuid())
  code      String?
  name      String
  type      PartnerType @default(CUSTOMER)
  contact   String?
  phone     String?
  email     String?
  taxId     String?
  address   String?
  customAttributes Json?
  isActive  Boolean     @default(true)
  companyId String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  orders  Order[]
  purchaseOrders PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  journalEntryLines JournalEntryLine[]

  @@unique([companyId, code])
  @@index([companyId, type])
}

model TaxCode {
  id             String   @id @default(uuid())
  code           String
  name           String
  rate           Decimal  @default(0) @db.Decimal(18,4)
  isTaxInclusive Boolean  @default(true)
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  accountId      String?
  companyId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id])
  account   Account? @relation(fields: [accountId], references: [id])
  orders    Order[]
  orderItems OrderItem[]
  invoices  Invoice[]

  @@unique([companyId, code])
  @@index([companyId, active])
  @@index([accountId])
}

// ==========================================
// 销售与订单引擎
// ==========================================

model Order {
  id           String    @id @default(uuid())
  orderNo      String    @unique
  partnerId    String
  salesId      String // 挂单销售员
  companyId    String
  status       String // "DRAFT", "PENDING", "IN_PRODUCTION", "SHIPPED", "COMPLETED"
  totalAmount  Decimal   @default(0) @db.Decimal(18,4)
  subTotal     Decimal   @default(0) @db.Decimal(18,4)
  taxTotal     Decimal   @default(0) @db.Decimal(18,4)
  taxCodeId    String?
  aiSummary    Json? // 存放 AI 抓取的客户需求 JSON 结构
  customAttributes Json?
  expectedDate DateTime? // 预计交付日期
  notes        String? // 备注

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner     Partner     @relation(fields: [partnerId], references: [id])
  salesPerson User        @relation("UserOrders", fields: [salesId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])
  taxCode     TaxCode?    @relation(fields: [taxCodeId], references: [id])
  items       OrderItem[]
  workOrders  WorkOrder[]
  invoices    Invoice[]
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  productId  String // 关联的产品/模型名称
  quantity   Int
  unitPrice  Decimal @db.Decimal(18,4)
  totalPrice Decimal @db.Decimal(18,4)
  subTotal   Decimal @default(0) @db.Decimal(18,4)
  taxAmount  Decimal @default(0) @db.Decimal(18,4)
  taxRate    Decimal @default(0) @db.Decimal(18,4)
  taxCodeId  String?
  customAttributes Json?

  order   Order    @relation(fields: [orderId], references: [id])
  taxCode TaxCode? @relation(fields: [taxCodeId], references: [id])
}

// ==========================================
// 采购与应付链路
// ==========================================

model PurchaseOrder {
  id           String   @id @default(uuid())
  purchaseNo   String   @unique
  supplierId   String
  buyerId      String
  companyId    String
  status       String   @default("DRAFT") // DRAFT / ORDERED / PARTIAL_RECEIVED / RECEIVED / CANCELLED
  totalAmount  Decimal  @default(0) @db.Decimal(18,4)
  subTotal     Decimal  @default(0) @db.Decimal(18,4)
  taxTotal     Decimal  @default(0) @db.Decimal(18,4)
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Partner @relation(fields: [supplierId], references: [id])
  buyer    User    @relation("UserPurchaseOrders", fields: [buyerId], references: [id])
  company  Company @relation(fields: [companyId], references: [id])
  items    PurchaseOrderLine[]
  receipts PurchaseReceipt[]
  invoices PurchaseInvoice[]

  @@index([companyId, status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  purchaseOrderId String
  materialId      String
  quantity        Decimal @db.Decimal(18,4)
  receivedQty     Decimal @default(0) @db.Decimal(18,4)
  unitPrice       Decimal @db.Decimal(18,4)
  subTotal        Decimal @default(0) @db.Decimal(18,4)
  taxAmount       Decimal @default(0) @db.Decimal(18,4)
  totalPrice      Decimal @default(0) @db.Decimal(18,4)
  note            String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  material      Material      @relation(fields: [materialId], references: [id])
  receiptLines  PurchaseReceiptLine[]

  @@index([purchaseOrderId])
  @@index([materialId])
}

model PurchaseReceipt {
  id              String   @id @default(uuid())
  receiptNo       String   @unique
  purchaseOrderId String
  companyId       String
  status          String   @default("POSTED") // POSTED / REVERSED
  receivedAt      DateTime @default(now())
  operatorId      String
  note            String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  company       Company              @relation(fields: [companyId], references: [id])
  operator      User                 @relation("UserPurchaseReceipts", fields: [operatorId], references: [id])
  lines         PurchaseReceiptLine[]

  @@index([companyId, receivedAt])
  @@index([purchaseOrderId])
}

model PurchaseReceiptLine {
  id                  String  @id @default(uuid())
  purchaseReceiptId   String
  purchaseOrderLineId String
  materialId          String
  quantity            Decimal @db.Decimal(18,4)
  destLocationId      String?
  batchNo             String?

  receipt           PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id])
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  material          Material          @relation(fields: [materialId], references: [id])
  destLocation      StockLocation?    @relation(fields: [destLocationId], references: [id])

  @@index([purchaseReceiptId])
  @@index([materialId])
}

model PurchaseInvoice {
  id              String   @id @default(uuid())
  invoiceNo       String   @unique
  purchaseOrderId String
  supplierId      String
  companyId       String
  amount          Decimal  @db.Decimal(18,4)
  subTotal        Decimal  @default(0) @db.Decimal(18,4)
  taxAmount       Decimal  @default(0) @db.Decimal(18,4)
  status          String   @default("UNPAID") // UNPAID / PARTIAL / PAID
  postingStatus   EntryPostingStatus @default(DRAFT)
  issuedDate      DateTime @default(now())
  dueDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplier      Partner       @relation(fields: [supplierId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([supplierId])
}

// ==========================================
// 智能仓储与物料管理
// ==========================================

model Warehouse {
  id        String @id @default(uuid())
  name      String // "原料库", "成品库", "零件半成品库"
  type      String // "MATERIAL", "FINISHED", "PART"
  companyId String

  company              Company                @relation(fields: [companyId], references: [id])
  locations            StockLocation[]
}

model StockLocation {
  id          String   @id @default(uuid())
  name        String
  code        String?
  usage       String   @default("INTERNAL") // INTERNAL / VIRTUAL / CUSTOMER / SUPPLIER
  isActive    Boolean  @default(true)
  companyId   String
  warehouseId String?
  parentId    String?  // 自引用父库位，支持 华南仓/货架区/A01层 层次结构
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company              Company                @relation(fields: [companyId], references: [id])
  warehouse            Warehouse?             @relation(fields: [warehouseId], references: [id])
  parent               StockLocation?         @relation("LocationTree", fields: [parentId], references: [id])
  children             StockLocation[]        @relation("LocationTree")
  quants               StockQuant[]
  outgoingTransactions InventoryTransaction[] @relation("StockMoveSourceLocation")
  incomingTransactions InventoryTransaction[] @relation("StockMoveDestinationLocation")
  purchaseReceiptLines PurchaseReceiptLine[]

  @@unique([companyId, code])
  @@index([companyId, warehouseId])
  @@index([companyId, parentId])
}

model Material {
  id          String  @id @default(uuid())
  sku         String  @unique
  name        String
  category    String // 例如：管材，板材，标准件
  description String?
  unit        String  @default("pcs")
  minStock    Decimal @default(0) @db.Decimal(18,4)
  unitPrice   Decimal @default(0) @db.Decimal(18,4)
  companyId   String? // 可选，如果为null则为系统预设物料

  company               Company?               @relation(fields: [companyId], references: [id])
  quants                StockQuant[]
  inventoryTransactions InventoryTransaction[]
  products              Product[]
  bomLines              BomLine[]
  purchaseOrderLines    PurchaseOrderLine[]
  purchaseReceiptLines  PurchaseReceiptLine[]
}

model ProductCategory {
  id        String   @id @default(uuid())
  name      String
  code      String?
  parentId  String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id])
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, code])
  @@index([companyId, parentId])
}

model Product {
  id          String      @id @default(uuid())
  sku         String
  name        String
  type        ProductType @default(STOCKABLE)
  categoryId  String?
  materialId  String?
  listPrice   Decimal     @default(0) @db.Decimal(18,4)
  uom         String      @default("pcs")
  description String?
  customAttributes Json?
  isActive    Boolean     @default(true)
  companyId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company  Company          @relation(fields: [companyId], references: [id])
  category ProductCategory? @relation(fields: [categoryId], references: [id])
  material Material?        @relation(fields: [materialId], references: [id])
  boms     Bom[]

  @@unique([companyId, sku])
  @@index([companyId, categoryId])
}

model Bom {
  id        String   @id @default(uuid())
  code      String?
  productId String
  version   String?
  isDefault Boolean  @default(true)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company   @relation(fields: [companyId], references: [id])
  product Product   @relation(fields: [productId], references: [id])
  lines   BomLine[]

  @@unique([companyId, code])
  @@index([companyId, productId])
}

model CustomFieldDefinition {
  id                   String          @id @default(uuid())
  modelName            String
  fieldName            String
  label                String
  type                 CustomFieldType
  required             Boolean         @default(false)
  referenceModel       String?
  referenceLabelField  String?
  referenceValueField  String?
  referenceRelationField String?
  companyId            String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, modelName, fieldName])
  @@index([companyId, modelName])
}

model BomLine {
  id         String  @id @default(uuid())
  bomId      String
  materialId String
  quantity   Decimal @db.Decimal(18,4)
  scrapRate  Decimal @default(0) @db.Decimal(18,4)
  note       String?

  bom      Bom      @relation(fields: [bomId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@index([bomId])
  @@index([materialId])
}

model StockQuant {
  id          String @id @default(uuid())
  locationId  String
  materialId  String
  batchNo     String
  quantity    Decimal @db.Decimal(18,4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location StockLocation @relation(fields: [locationId], references: [id])
  material Material      @relation(fields: [materialId], references: [id])

  @@unique([locationId, materialId, batchNo])
  @@index([materialId])
}

// ==========================================
// 附加模块: 文件、流转、制造与财务
// ==========================================

model FileRecord {
  id         String   @id @default(uuid())
  fileName   String
  fileSize   Int
  mimeType   String
  objectKey  String // MinIO object name
  companyId  String
  uploaderId String
  createdAt  DateTime @default(now())

  company  Company @relation(fields: [companyId], references: [id])
  uploader User    @relation(fields: [uploaderId], references: [id])
}

model InventoryTransaction {
  id                String   @id @default(uuid())
  type              String // "INBOUND", "OUTBOUND", "TRANSFER"
  materialId        String
  sourceLocationId  String?
  destLocationId    String?
  quantity          Decimal  @db.Decimal(18,4)
  batchNo           String?
  operatorId        String
  companyId         String
  referenceNo       String? // 关联单号（订单号/采购号等）
  note              String?
  createdAt         DateTime @default(now())

  material        Material       @relation(fields: [materialId], references: [id])
  company         Company        @relation(fields: [companyId], references: [id])
  sourceLocation  StockLocation? @relation("StockMoveSourceLocation", fields: [sourceLocationId], references: [id])
  destLocation    StockLocation? @relation("StockMoveDestinationLocation", fields: [destLocationId], references: [id])

  @@index([companyId, materialId])
  @@index([sourceLocationId])
  @@index([destLocationId])
}

model Workflow {
  id          String   @id @default(uuid())
  modelName   String
  companyId   String?
  name        String
  statusField String   @default("status")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?              @relation(fields: [companyId], references: [id])
  states      WorkflowState[]
  transitions WorkflowTransition[]

  @@unique([companyId, modelName])
  @@index([modelName])
}

model WorkflowState {
  id         String   @id @default(uuid())
  workflowId String
  value      String
  label      String
  isInitial  Boolean  @default(false)
  isFinal    Boolean  @default(false)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workflow Workflow             @relation(fields: [workflowId], references: [id])
  from     WorkflowTransition[] @relation("WorkflowTransitionFrom")
  to       WorkflowTransition[] @relation("WorkflowTransitionTo")

  @@unique([workflowId, value])
  @@index([workflowId, sort])
}

model WorkflowTransition {
  id          String   @id @default(uuid())
  workflowId  String
  fromStateId String
  toStateId   String
  action      String
  label       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflow  Workflow      @relation(fields: [workflowId], references: [id])
  fromState WorkflowState @relation("WorkflowTransitionFrom", fields: [fromStateId], references: [id])
  toState   WorkflowState @relation("WorkflowTransitionTo", fields: [toStateId], references: [id])

  @@unique([workflowId, fromStateId, action])
  @@index([workflowId, action])
}

model WorkOrder {
  id          String   @id @default(uuid())
  workOrderNo String   @unique
  orderId     String
  productId   String
  plannedQty  Int
  actualQty   Int      @default(0)
  status      String // "PENDING", "IN_PROGRESS", "COMPLETED"
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order   Order        @relation(fields: [orderId], references: [id])
  reports WorkReport[]
}

model WorkReport {
  id          String   @id @default(uuid())
  workOrderId String
  workerId    String
  goodQty     Int
  defectQty   Int
  reportDate  DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  worker    User      @relation(fields: [workerId], references: [id])
}

model Invoice {
  id         String    @id @default(uuid())
  invoiceNo  String    @unique
  orderId    String
  amount     Decimal  @db.Decimal(18,4)
  subTotal   Decimal  @default(0) @db.Decimal(18,4)
  taxAmount  Decimal  @default(0) @db.Decimal(18,4)
  taxCodeId  String?
  status     String // "UNPAID", "PARTIAL", "PAID"
  postingStatus EntryPostingStatus @default(DRAFT)
  companyId  String
  dueDate    DateTime?
  issuedDate DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order    Order     @relation(fields: [orderId], references: [id])
  taxCode  TaxCode?  @relation(fields: [taxCodeId], references: [id])
  payments Payment[]
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  amount      Decimal  @db.Decimal(18,4)
  paymentDate DateTime @default(now())
  method      String // "BANK_TRANSFER", "CASH", "WECHAT", "ALIPAY"

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Account {
  id        String   @id @default(uuid())
  code      String
  name      String
  type      String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  parentId  String?
  companyId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children Account[] @relation("AccountTree")
  company  Company   @relation(fields: [companyId], references: [id])
  lines    JournalEntryLine[]
  taxCodes TaxCode[]

  @@unique([companyId, code])
  @@index([companyId, parentId])
}

model Journal {
  id        String      @id @default(uuid())
  code      String
  name      String
  type      JournalType @default(GENERAL)
  companyId String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company        @relation(fields: [companyId], references: [id])
  entries JournalEntry[]

  @@unique([companyId, code])
  @@index([companyId, type])
}

model JournalEntry {
  id            String             @id @default(uuid())
  entryNo       String
  date          DateTime
  ref           String?
  description   String?
  journalId     String
  companyId     String
  postingStatus EntryPostingStatus @default(DRAFT)
  createdBy     String?
  postedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  journal Journal            @relation(fields: [journalId], references: [id])
  company Company            @relation(fields: [companyId], references: [id])
  lines   JournalEntryLine[]

  @@unique([companyId, entryNo])
  @@index([companyId, journalId, date])
}

model JournalEntryLine {
  id             String   @id @default(uuid())
  journalEntryId String
  lineNo         Int
  accountId      String
  partnerId      String?
  debit          Decimal  @default(0) @db.Decimal(18,4)
  credit         Decimal  @default(0) @db.Decimal(18,4)
  memo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
  partner      Partner?     @relation(fields: [partnerId], references: [id])

  @@unique([journalEntryId, lineNo])
  @@index([accountId])
  @@index([partnerId])
}

model EventDlq {
  id             String   @id @default(uuid())
  eventName      String
  idempotencyKey String?
  payload        Json
  error          String
  attempts       Int      @default(1)
  maxAttempts    Int      @default(5)
  nextRetryAt    DateTime?
  status         String   @default("PENDING")
  companyId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  @@index([status, nextRetryAt])
  @@index([eventName])
  @@index([eventName, idempotencyKey])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   Json?
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
}
