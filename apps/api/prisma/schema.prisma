// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 核心模块: 多公司与统一认证
// ==========================================

model Company {
  id          String   @id @default(uuid())
  name        String // 公司名称
  taxId       String? // 税号
  address     String? // 公司地址
  phone       String? // 联系电话
  legalPerson String? // 法定代表人
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                         UserCompanyRole[]
  departments                   Department[]
  orders                        Order[]
  warehouses                    Warehouse[]
  locations                     StockLocation[]
  materials                     Material[]
  partners                      Partner[]
  products                      Product[]
  categories                    ProductCategory[]
  boms                          Bom[]
  fileRecords                   FileRecord[]
  workflows                     Workflow[]
  customFields                  CustomFieldDefinition[]
  auditLogs                     AuditLog[]
  accounts                      Account[]
  financeAccountMappings        FinanceAccountMapping[]
  journals                      Journal[]
  journalEntries                JournalEntry[]
  accountingPeriods             AccountingPeriod[]
  payments                      Payment[]
  paymentAllocations            PaymentAllocation[]
  supplierPayments              SupplierPayment[]
  supplierPaymentAllocations    SupplierPaymentAllocation[]
  bankStatementLines            BankStatementLine[]
  creditNotes                   CreditNote[]
  customerRefunds               CustomerRefund[]
  eventDlqRecords               EventDlq[]
  taxCodes                      TaxCode[]
  userInvitations               UserInvitation[]
  inventoryTransactions         InventoryTransaction[]
  inventoryLedgerSnapshots      InventoryLedgerSnapshot[]
  materialCosts                 MaterialCost[]
  inventoryReturnDocuments      InventoryReturnDocument[]
  supplierCreditNotes           SupplierCreditNote[]
  purchaseOrders                PurchaseOrder[]
  purchaseReceipts              PurchaseReceipt[]
  purchaseInvoices              PurchaseInvoice[]
  aiProviderSetting             AiProviderSetting?
  documentSequences             DocumentSequence[]
  customerRequirements          CustomerRequirement[]
  requirementActivities         RequirementActivity[]
  quotes                        Quote[]
  quoteVersions                 QuoteVersion[]
  quoteVersionItems             QuoteVersionItem[]
  salesContracts                SalesContract[]
  salesContractVersions         SalesContractVersion[]
  salesContractApprovals        SalesContractApproval[]
  engineeringDocuments          EngineeringDocument[]
  engineeringDocumentRevisions  EngineeringDocumentRevision[]
  workOrderEngineeringRevisions WorkOrderEngineeringRevision[]
  engineeringChangeOrders       EngineeringChangeOrder[]
  engineeringChangeImpacts      EngineeringChangeImpact[]
  workReports                   WorkReport[]
  workReportReversals           WorkReportReversal[]
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum ProductType {
  STOCKABLE
  CONSUMABLE
  SERVICE
}

enum CustomFieldType {
  STRING
  NUMBER
  REF
}

enum JournalType {
  GENERAL
  CASH
  BANK
  SALES
  PURCHASE
  INVENTORY
}

enum EntryPostingStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

enum BankStatementLineStatus {
  UNMATCHED
  MATCHED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies                       UserCompanyRole[]
  orders                          Order[]                        @relation("UserOrders")
  purchaseOrders                  PurchaseOrder[]                @relation("UserPurchaseOrders")
  purchaseReceipts                PurchaseReceipt[]              @relation("UserPurchaseReceipts")
  FileRecord                      FileRecord[]
  WorkReport                      WorkReport[]
  workReportReversals             WorkReportReversal[]           @relation("WorkReportReversedBy")
  auditLogs                       AuditLog[]
  createdInvitations              UserInvitation[]               @relation("InvitationCreatedBy")
  acceptedInvitations             UserInvitation[]               @relation("InvitationAcceptedBy")
  ownedRequirements               CustomerRequirement[]          @relation("RequirementOwner")
  requirementActivities           RequirementActivity[]          @relation("RequirementActivityCreator")
  ownedQuotes                     Quote[]                        @relation("QuoteOwner")
  ownedContracts                  SalesContract[]                @relation("ContractOwner")
  contractApprovals               SalesContractApproval[]        @relation("ContractApprovalActor")
  signedContracts                 SalesContract[]                @relation("ContractSigner")
  createdEngineeringDocuments     EngineeringDocument[]          @relation("EngineeringDocumentCreator")
  createdEngineeringRevisions     EngineeringDocumentRevision[]  @relation("EngineeringRevisionCreator")
  reviewedEngineeringRevisions    EngineeringDocumentRevision[]  @relation("EngineeringRevisionReviewer")
  approvedEngineeringRevisions    EngineeringDocumentRevision[]  @relation("EngineeringRevisionApprover")
  pinnedEngineeringRevisions      WorkOrderEngineeringRevision[] @relation("EngineeringRevisionPinnedBy")
  createdEngineeringChangeOrders  EngineeringChangeOrder[]       @relation("EngineeringChangeOrderCreator")
  approvedEngineeringChangeOrders EngineeringChangeOrder[]       @relation("EngineeringChangeOrderApprover")
}

model Role {
  id          String   @id @default(uuid())
  name        String // "ADMIN", "SALES", "MANAGER" 等
  permissions String[] // JSON or Array 存放详细权限点，例如 ["order:read", "order:write"]

  users       UserCompanyRole[]
  invitations UserInvitation[]
}

// 用户在特定公司下的角色关联表
model UserCompanyRole {
  id        String @id @default(uuid())
  userId    String
  companyId String
  roleId    String

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
}

model UserInvitation {
  id           String    @id @default(uuid())
  email        String
  name         String?
  tokenHash    String    @unique
  companyId    String
  roleId       String
  createdById  String
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company @relation(fields: [companyId], references: [id])
  role       Role    @relation(fields: [roleId], references: [id])
  createdBy  User    @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([companyId, email])
  @@index([companyId, createdAt])
}

model Department {
  id        String @id @default(uuid())
  name      String
  companyId String

  company Company @relation(fields: [companyId], references: [id])
}

model Partner {
  id               String      @id @default(uuid())
  code             String?
  name             String
  type             PartnerType @default(CUSTOMER)
  contact          String?
  phone            String?
  email            String?
  taxId            String?
  address          String?
  customAttributes Json?
  isActive         Boolean     @default(true)
  companyId        String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company              Company               @relation(fields: [companyId], references: [id])
  orders               Order[]
  purchaseOrders       PurchaseOrder[]
  purchaseInvoices     PurchaseInvoice[]
  journalEntryLines    JournalEntryLine[]
  payments             Payment[]
  supplierPayments     SupplierPayment[]
  creditNotes          CreditNote[]
  customerRefunds      CustomerRefund[]
  supplierCreditNotes  SupplierCreditNote[]
  customerRequirements CustomerRequirement[]
  quotes               Quote[]
  salesContracts       SalesContract[]

  @@unique([companyId, code])
  @@index([companyId, type])
}

model DocumentSequence {
  id           String   @id @default(uuid())
  companyId    String
  documentType String
  year         Int
  lastValue    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType, year])
  @@index([companyId, year])
}

model CustomerRequirement {
  id                String    @id @default(uuid())
  requirementNo     String
  companyId         String
  partnerId         String
  ownerId           String
  status            String    @default("DRAFT")
  sourceChannel     String
  summary           String
  estimatedAmount   Decimal?  @db.Decimal(18, 4)
  expectedCloseDate DateTime?
  nextFollowUpAt    DateTime?
  closeReason       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner    Partner               @relation(fields: [partnerId], references: [id])
  owner      User                  @relation("RequirementOwner", fields: [ownerId], references: [id])
  activities RequirementActivity[]
  quotes     Quote[]

  @@unique([companyId, requirementNo])
  @@index([companyId, status, updatedAt])
  @@index([companyId, ownerId, nextFollowUpAt])
  @@index([partnerId, createdAt])
}

model RequirementActivity {
  id             String    @id @default(uuid())
  requirementId  String
  companyId      String
  activityType   String    @default("FOLLOW_UP")
  content        String
  nextFollowUpAt DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  requirement CustomerRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("RequirementActivityCreator", fields: [createdById], references: [id])

  @@index([companyId, requirementId, createdAt])
  @@index([createdById, createdAt])
}

model Quote {
  id               String   @id @default(uuid())
  quoteNo          String
  companyId        String
  requirementId    String
  partnerId        String
  ownerId          String
  currentVersionNo Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requirement CustomerRequirement @relation(fields: [requirementId], references: [id])
  partner     Partner             @relation(fields: [partnerId], references: [id])
  owner       User                @relation("QuoteOwner", fields: [ownerId], references: [id])
  versions    QuoteVersion[]

  @@unique([companyId, quoteNo])
  @@unique([companyId, requirementId])
  @@index([companyId, partnerId, updatedAt])
  @@index([companyId, ownerId, updatedAt])
}

model QuoteVersion {
  id                 String    @id @default(uuid())
  quoteId            String
  companyId          String
  versionNo          Int
  status             String    @default("DRAFT")
  currencyCode       String
  baseCurrencyCode   String
  exchangeRate       Decimal   @db.Decimal(18, 8)
  exchangeRateAt     DateTime
  exchangeRateSource String
  validUntil         DateTime
  paymentTerms       String?
  deliveryTerms      String?
  subtotal           Decimal   @db.Decimal(18, 4)
  taxTotal           Decimal   @db.Decimal(18, 4)
  total              Decimal   @db.Decimal(18, 4)
  sentAt             DateTime?
  acceptedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  quote    Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items    QuoteVersionItem[]
  contract SalesContract?

  @@unique([quoteId, versionNo])
  @@index([companyId, status, updatedAt])
}

model QuoteVersionItem {
  id             String   @id @default(uuid())
  quoteVersionId String
  companyId      String
  productId      String
  skuSnapshot    String
  nameSnapshot   String
  uomSnapshot    String
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @db.Decimal(18, 4)
  discountRate   Decimal  @default(0) @db.Decimal(18, 8)
  taxRate        Decimal  @default(0) @db.Decimal(18, 8)
  netAmount      Decimal  @db.Decimal(18, 4)
  taxAmount      Decimal  @db.Decimal(18, 4)
  grossAmount    Decimal  @db.Decimal(18, 4)
  createdAt      DateTime @default(now())

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  orderItems   OrderItem[]

  @@index([companyId, quoteVersionId])
  @@index([companyId, productId])
}

model SalesContract {
  id               String    @id @default(uuid())
  contractNo       String
  companyId        String
  quoteVersionId   String    @unique
  partnerId        String
  ownerId          String
  status           String    @default("DRAFT")
  currentVersionNo Int       @default(1)
  submittedAt      DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  signedFileId     String?   @unique
  signedById       String?
  signedAt         DateTime?
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteVersion QuoteVersion            @relation(fields: [quoteVersionId], references: [id])
  partner      Partner                 @relation(fields: [partnerId], references: [id])
  owner        User                    @relation("ContractOwner", fields: [ownerId], references: [id])
  signedFile   FileRecord?             @relation(fields: [signedFileId], references: [id], onDelete: Restrict)
  signedBy     User?                   @relation("ContractSigner", fields: [signedById], references: [id])
  versions     SalesContractVersion[]
  approvals    SalesContractApproval[]
  orders       Order[]

  @@unique([companyId, contractNo])
  @@index([companyId, partnerId, updatedAt])
  @@index([companyId, status, updatedAt])
}

model SalesContractApproval {
  id         String   @id @default(uuid())
  contractId String
  companyId  String
  actorId    String
  stage      String
  decision   String
  comment    String?
  createdAt  DateTime @default(now())

  contract SalesContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor    User          @relation("ContractApprovalActor", fields: [actorId], references: [id])

  @@index([companyId, contractId, createdAt])
  @@index([actorId, createdAt])
}

model SalesContractVersion {
  id                 String    @id @default(uuid())
  contractId         String
  companyId          String
  versionNo          Int
  title              String
  status             String    @default("DRAFT")
  currencyCode       String
  baseCurrencyCode   String
  exchangeRate       Decimal   @db.Decimal(18, 8)
  exchangeRateAt     DateTime
  exchangeRateSource String
  total              Decimal   @db.Decimal(18, 4)
  paymentTerms       String?
  deliveryTerms      String?
  effectiveAt        DateTime?
  expiresAt          DateTime?
  signedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contract SalesContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([contractId, versionNo])
  @@index([companyId, status, updatedAt])
}

model TaxCode {
  id             String   @id @default(uuid())
  code           String
  name           String
  rate           Decimal  @default(0) @db.Decimal(18, 4)
  isTaxInclusive Boolean  @default(true)
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  accountId      String?
  companyId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  account     Account?     @relation(fields: [accountId], references: [id])
  orders      Order[]
  orderItems  OrderItem[]
  invoices    Invoice[]
  creditNotes CreditNote[]

  @@unique([companyId, code])
  @@index([companyId, active])
  @@index([accountId])
}

// ==========================================
// 销售与订单引擎
// ==========================================

model Order {
  id                String    @id @default(uuid())
  orderNo           String    @unique
  partnerId         String
  salesId           String // 挂单销售员
  companyId         String
  status            String // "DRAFT", "PENDING", "IN_PRODUCTION", "SHIPPED", "COMPLETED"
  totalAmount       Decimal   @default(0) @db.Decimal(18, 4)
  subTotal          Decimal   @default(0) @db.Decimal(18, 4)
  taxTotal          Decimal   @default(0) @db.Decimal(18, 4)
  taxCodeId         String?
  aiSummary         Json? // 存放 AI 抓取的客户需求 JSON 结构
  customAttributes  Json?
  expectedDate      DateTime? // 预计交付日期
  notes             String? // 备注
  salesContractId   String?
  contractVersionId String?
  sourceBatchKey    String?
  sourceBatchHash   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner              Partner               @relation(fields: [partnerId], references: [id])
  salesPerson          User                  @relation("UserOrders", fields: [salesId], references: [id])
  company              Company               @relation(fields: [companyId], references: [id])
  taxCode              TaxCode?              @relation(fields: [taxCodeId], references: [id])
  items                OrderItem[]
  workOrders           WorkOrder[]
  invoices             Invoice[]
  salesContract        SalesContract?        @relation(fields: [salesContractId], references: [id], onDelete: Restrict)
  contractVersion      SalesContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: Restrict)
  engineeringDocuments EngineeringDocument[]

  @@unique([companyId, sourceBatchKey])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([salesContractId, createdAt])
}

model OrderItem {
  id                       String  @id @default(uuid())
  orderId                  String
  productId                String // 关联的产品/模型名称
  quantity                 Int
  unitPrice                Decimal @db.Decimal(18, 4)
  totalPrice               Decimal @db.Decimal(18, 4)
  subTotal                 Decimal @default(0) @db.Decimal(18, 4)
  taxAmount                Decimal @default(0) @db.Decimal(18, 4)
  taxRate                  Decimal @default(0) @db.Decimal(18, 4)
  taxCodeId                String?
  customAttributes         Json?
  sourceQuoteVersionItemId String?

  order                  Order             @relation(fields: [orderId], references: [id])
  taxCode                TaxCode?          @relation(fields: [taxCodeId], references: [id])
  sourceQuoteVersionItem QuoteVersionItem? @relation(fields: [sourceQuoteVersionItemId], references: [id], onDelete: Restrict)

  @@index([sourceQuoteVersionItemId])
}

// ==========================================
// 采购与应付链路
// ==========================================

model PurchaseOrder {
  id           String    @id @default(uuid())
  purchaseNo   String    @unique
  supplierId   String
  buyerId      String
  companyId    String
  status       String    @default("DRAFT") // DRAFT / ORDERED / PARTIAL_RECEIVED / RECEIVED / CANCELLED
  totalAmount  Decimal   @default(0) @db.Decimal(18, 4)
  subTotal     Decimal   @default(0) @db.Decimal(18, 4)
  taxTotal     Decimal   @default(0) @db.Decimal(18, 4)
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplier Partner             @relation(fields: [supplierId], references: [id])
  buyer    User                @relation("UserPurchaseOrders", fields: [buyerId], references: [id])
  company  Company             @relation(fields: [companyId], references: [id])
  items    PurchaseOrderLine[]
  receipts PurchaseReceipt[]
  invoices PurchaseInvoice[]

  @@index([companyId, status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  purchaseOrderId String
  materialId      String
  quantity        Decimal @db.Decimal(18, 4)
  receivedQty     Decimal @default(0) @db.Decimal(18, 4)
  unitPrice       Decimal @db.Decimal(18, 4)
  subTotal        Decimal @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal @default(0) @db.Decimal(18, 4)
  totalPrice      Decimal @default(0) @db.Decimal(18, 4)
  note            String?

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  material      Material              @relation(fields: [materialId], references: [id])
  receiptLines  PurchaseReceiptLine[]

  @@index([purchaseOrderId])
  @@index([materialId])
}

model PurchaseReceipt {
  id              String   @id @default(uuid())
  receiptNo       String   @unique
  purchaseOrderId String
  companyId       String
  status          String   @default("POSTED") // POSTED / REVERSED
  receivedAt      DateTime @default(now())
  operatorId      String
  note            String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  company       Company               @relation(fields: [companyId], references: [id])
  operator      User                  @relation("UserPurchaseReceipts", fields: [operatorId], references: [id])
  lines         PurchaseReceiptLine[]

  @@index([companyId, receivedAt])
  @@index([purchaseOrderId])
}

model PurchaseReceiptLine {
  id                  String  @id @default(uuid())
  purchaseReceiptId   String
  purchaseOrderLineId String
  materialId          String
  quantity            Decimal @db.Decimal(18, 4)
  destLocationId      String?
  batchNo             String?

  receipt           PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id])
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  material          Material          @relation(fields: [materialId], references: [id])
  destLocation      StockLocation?    @relation(fields: [destLocationId], references: [id])

  @@index([purchaseReceiptId])
  @@index([materialId])
}

model PurchaseInvoice {
  id              String             @id @default(uuid())
  invoiceNo       String             @unique
  purchaseOrderId String
  supplierId      String
  companyId       String
  amount          Decimal            @db.Decimal(18, 4)
  subTotal        Decimal            @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal            @default(0) @db.Decimal(18, 4)
  status          String             @default("UNPAID") // UNPAID / PARTIAL / PAID
  postingStatus   EntryPostingStatus @default(DRAFT)
  issuedDate      DateTime           @default(now())
  dueDate         DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  purchaseOrder              PurchaseOrder               @relation(fields: [purchaseOrderId], references: [id])
  supplier                   Partner                     @relation(fields: [supplierId], references: [id])
  company                    Company                     @relation(fields: [companyId], references: [id])
  supplierCreditNotes        SupplierCreditNote[]
  supplierPaymentAllocations SupplierPaymentAllocation[]

  @@index([companyId, status])
  @@index([supplierId])
}

// ==========================================
// 智能仓储与物料管理
// ==========================================

model Warehouse {
  id        String @id @default(uuid())
  name      String // "原料库", "成品库", "零件半成品库"
  type      String // "MATERIAL", "FINISHED", "PART"
  companyId String

  company   Company         @relation(fields: [companyId], references: [id])
  locations StockLocation[]
}

model StockLocation {
  id          String   @id @default(uuid())
  name        String
  code        String?
  usage       String   @default("INTERNAL") // INTERNAL / VIRTUAL / CUSTOMER / SUPPLIER
  isActive    Boolean  @default(true)
  companyId   String
  warehouseId String?
  parentId    String? // 自引用父库位，支持 华南仓/货架区/A01层 层次结构
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company              Company                   @relation(fields: [companyId], references: [id])
  warehouse            Warehouse?                @relation(fields: [warehouseId], references: [id])
  parent               StockLocation?            @relation("LocationTree", fields: [parentId], references: [id])
  children             StockLocation[]           @relation("LocationTree")
  quants               StockQuant[]
  ledgerSnapshots      InventoryLedgerSnapshot[]
  outgoingTransactions InventoryTransaction[]    @relation("StockMoveSourceLocation")
  incomingTransactions InventoryTransaction[]    @relation("StockMoveDestinationLocation")
  purchaseReceiptLines PurchaseReceiptLine[]

  @@unique([companyId, code])
  @@index([companyId, warehouseId])
  @@index([companyId, parentId])
}

model Material {
  id          String  @id @default(uuid())
  sku         String  @unique
  name        String
  category    String // 例如：管材，板材，标准件
  description String?
  unit        String  @default("pcs")
  minStock    Decimal @default(0) @db.Decimal(18, 4)
  unitPrice   Decimal @default(0) @db.Decimal(18, 4)
  companyId   String? // 可选，如果为null则为系统预设物料

  company               Company?                  @relation(fields: [companyId], references: [id])
  quants                StockQuant[]
  ledgerSnapshots       InventoryLedgerSnapshot[]
  materialCosts         MaterialCost[]
  inventoryTransactions InventoryTransaction[]
  products              Product[]
  bomLines              BomLine[]
  purchaseOrderLines    PurchaseOrderLine[]
  purchaseReceiptLines  PurchaseReceiptLine[]
}

model ProductCategory {
  id        String   @id @default(uuid())
  name      String
  code      String?
  parentId  String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id])
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, code])
  @@index([companyId, parentId])
}

model Product {
  id               String      @id @default(uuid())
  sku              String
  name             String
  type             ProductType @default(STOCKABLE)
  categoryId       String?
