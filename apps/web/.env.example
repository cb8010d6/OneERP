# ============================================================
#  OneERP Web 前端 (.env.example)
#  复制本文件为 .env.local 并填写实际值:
#    cp .env.example .env.local
# ============================================================

# ---- API 基础地址 ----
# 前端 axios 实例请求后端 API 的 baseURL
# 开发环境可使用默认值 http://127.0.0.1:8000/api（代码内置回退）
# 生产环境请根据实际部署地址配置，例如:
#   NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api
#   NEXT_PUBLIC_API_BASE_URL=/api/proxy  (搭配 Next.js rewrites 使用反向代理)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
