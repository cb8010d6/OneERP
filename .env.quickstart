# This template is copied by scripts/quickstart.*.
# Quickstart may generate local secrets automatically.
# Production rule: never deploy with CHANGE_ME values, short secrets, or the
# default admin password. Run scripts/audit-prod-config.* before go-live.

POSTGRES_USER=oneerp
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=oneerp

JWT_SECRET=CHANGE_ME_JWT_SECRET

MINIO_ACCESS_KEY=oneerp_minio
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET

INIT_ADMIN_EMAIL=admin@oneerp.local
INIT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
INIT_ADMIN_NAME=Administrator
INIT_COMPANY_NAME=OneERP Company

API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/proxy

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional backup policy. Copy ops/backup-policy.example.json and adjust paths.
BACKUP_POLICY_FILE=ops/backup-policy.example.json
